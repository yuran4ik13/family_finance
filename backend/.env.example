# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must NEVER be pushed to GitHub.

# development | production
NODE_ENV="development"
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/family_finance"

# Secret that signs login cookies. At least 32 random characters.
# Generate:  openssl rand -base64 48
# (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=""

# How many hours a login lasts
SESSION_HOURS=12

# Address of the frontend. Only this origin may call the API.
FRONTEND_ORIGIN="http://localhost:5173"

# "true" only when running behind a hosting proxy (Render, Railway, Nginx...)
TRUST_PROXY="false"

# "strict" if frontend and API are on the same site (recommended),
# "none" only if they are on different domains (HTTPS required)
COOKIE_SAMESITE="strict"

# Personal token from https://api.monobank.ua
# Leave EMPTY on a public demo server.
MONOBANK_TOKEN="your_monobank_token_here"

# Personal categorization rules (comma separated, lowercase).
# Text that marks transfers between your own cards / family members:
PERSONAL_TRANSFER_MARKERS="від: your name,from: family member"
# Text that marks income from family:
FAMILY_INCOME_MARKERS="від: family member"
