# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must NEVER be pushed to GitHub.

# development | production
NODE_ENV="development"
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/family_finance"

# Secret that signs login cookies. At least 32 random characters.
# Generate:  openssl rand -base64 48
JWT_SECRET=""

# Key that encrypts users' bank tokens in the database. 32 bytes, base64.
# Generate:  openssl rand -base64 32
# Back it up! If it's lost, users have to reconnect their bank.
# Must be different from JWT_SECRET.
ENCRYPTION_KEY=""

# How many hours a login lasts
SESSION_HOURS=12

# Address of the frontend. Only this origin may call the API.
FRONTEND_ORIGIN="http://localhost:5173"

# "true" opens the Sign up page for everyone.
# Keep "false" on your laptop; "true" only on a server for other people.
ALLOW_REGISTRATION="false"

# "true" only when running behind a hosting proxy (Render, Railway, Nginx...)
TRUST_PROXY="false"

# "strict" if frontend and API are on the same site (recommended),
# "none" only if they are on different domains (HTTPS required)
COOKIE_SAMESITE="strict"

# --- No longer used by the server (multi-user version) ---
# Each user now connects their own Monobank token on the Settings page
# (stored encrypted). To move your old values into your account once:
#   npm run import-env-settings -- you@example.com
# MONOBANK_TOKEN=""
# PERSONAL_TRANSFER_MARKERS=""
# FAMILY_INCOME_MARKERS=""
